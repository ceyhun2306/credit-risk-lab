# Şablon: cp .env.example .env  və CHANGE_ME yerlərini doldur
AIRFLOW_IMAGE_NAME=credit-airflow:3.1.0
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_UID=50000

AIRFLOW__CORE__EXECUTOR=LocalExecutor
# Şifrə POSTGRES_PASSWORD ilə eyni olmalıdır
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:CHANGE_ME@postgres/airflow
# docker run --rm apache/airflow:3.1.0 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags/
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
# docker run --rm apache/airflow:3.1.0 python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API__SECRET_KEY=CHANGE_ME
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME

POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=airflow

# MinIO şifrəsi ən azı 8 simvol olmalıdır
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_SERVER_URL=http://minio:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9011

AIRFLOW_CONN_SPARK_DEFAULT={"conn_type": "spark", "host": "local[*]"}
